datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id
  email        String        @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  reservations Reservation[]
  orders       Order[]

  @@map("users")
}

model Product {
  id           String        @id
  sku          String        @unique
  name         String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  category     String?       @default("Electronics")
  imageUrl     String?       @map("image_url")
  createdAt    DateTime      @default(now()) @map("created_at")
  inventory    Inventory?
  reservations Reservation[]
  orders       Order[]
  orderItems   OrderItem[]

  @@map("products")
}

model Inventory {
  id             String        @id
  productId      String        @unique @map("product_id")
  totalStock     Int           @map("total_stock")
  availableStock Int           @map("available_stock")
  reservedStock  Int           @default(0) @map("reserved_stock")
  version        Int           @default(1)
  product        Product       @relation(fields: [productId], references: [id])
  reservations   Reservation[]

  @@map("inventories")
}

model Reservation {
  id               String   @id
  inventoryId      String   @map("inventory_id")
  productId        String   @map("product_id")
  userId           String   @map("user_id")
  reservationToken String   @unique @map("reservation_token")
  quantity         Int      @default(1)
  status           String
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  order     Order?

  @@unique([inventoryId, userId], name: "uq_user_inventory")
  @@map("reservations")
}

model Order {
  id             String              @id
  orderNumber    String              @unique @map("order_number")
  reservationId  String?             @unique @map("reservation_id")
  userId         String              @map("user_id")
  productId      String              @map("product_id")
  quantity       Int                 @default(1)
  totalAmount    Decimal             @map("total_amount") @db.Decimal(10, 2)
  status         String
  idempotencyKey String              @unique @map("idempotency_key")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @default(now()) @map("updated_at")
  reservation    Reservation?        @relation(fields: [reservationId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])
  payments       PaymentTransaction[]
  items          OrderItem[]

  @@map("orders")
}

model OrderItem {
  id               String   @id
  orderId          String   @map("order_id")
  productId        String   @map("product_id")
  quantity         Int      @default(1)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(10, 2)
  reservationToken String   @map("reservation_token")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model PaymentTransaction {
  id               String   @id
  orderId          String   @map("order_id")
  paymentReference String?  @unique @map("payment_reference")
  provider         String?  @default("MOCK_GATEWAY")
  amount           Decimal  @db.Decimal(10, 2)
  status           String
  idempotencyKey   String   @unique @map("idempotency_key")
  rawResponse      Json?    @map("raw_response")
  createdAt        DateTime @default(now()) @map("created_at")
  order            Order    @relation(fields: [orderId], references: [id])

  @@map("payment_transactions")
}

model IdempotencyRecord {
  key          String   @id
  scope        String
  status       String
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@map("idempotency_records")
}

model InventoryAuditLog {
  id                Int      @id @default(autoincrement())
  productId         String   @map("product_id")
  action            String
  delta             Int
  currentRedisStock Int      @map("current_redis_stock")
  currentDbStock    Int      @map("current_db_stock")
  referenceId       String?  @map("reference_id")
  timestamp         DateTime @default(now())

  @@map("inventory_audit_logs")
}
